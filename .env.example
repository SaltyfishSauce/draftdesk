# Copy to .env and fill in only the values your config.yaml references.
# Never commit the real file.

# Dashboard (required whenever it listens on anything but localhost)
DRAFTDESK_DASHBOARD_PASSWORD=

# --- Mail: Microsoft 365 (provider: graph) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Mail: Gmail (provider: gmail) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Mail: IMAP/SMTP (provider: imap) ---
IMAP_PASSWORD=

# --- Store ---
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_ACCESS_TOKEN=
SHOPIFY_ACCESS_TOKEN=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- Model ---
# The Anthropic adapter reads this itself; it is not referenced from config.yaml.
ANTHROPIC_API_KEY=
# For provider: openai_compatible
LLM_API_KEY=
